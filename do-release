#!/bin/zsh
# Builds a Pulse2Alike release: both plug-ins (VST3 and Audio Unit), universal (arm64 + x86_64), ad-hoc signed, in a
# .dmg on the Desktop with a "Read Me First.txt" - ready to attach to a GitHub release. G2-Edit's do-release is the
# model: the version comes from git tags and the .dmg is built BEFORE the tag exists, so name the part to bump:
#
#   ./do-release beta      V0.1.0-beta.1 -> V0.1.0-beta.2   (the everyday one)
#   ./do-release patch     V0.1.0-beta.1 -> V0.1.1-beta.1
#   ./do-release minor     V0.1.0-beta.1 -> V0.2.0-beta.1
#   ./do-release major     V0.1.0-beta.1 -> V1.0.0-beta.1
#   ./do-release final     V0.1.0-beta.1 -> V0.1.0
#   ./do-release 0.1.0-beta.1   a version as given (the first release: there is no tag yet)
#   ./do-release           reuse the newest tag (rebuild an old release)
#
# It never creates or pushes the tag: it prints the commands, to run once the .dmg has been checked.
# Needs the VST3 SDK (see do-plugin) - a release ships both formats or it stops.

set -e

ARG_BUMP="$1"
DIST="${2:-$HOME/Desktop}"
DIST="${DIST:a}"

cd ${0:a:h}

VOL_NAME="Pulse2Alike"

# A temporary tree, removed on the way out: never on a host's VST3 search path (scanning recurses, and a second
# bundle of the same name there is loaded instead of the installed one), and never the working build/ directory
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# --- version -------------------------------------------------------------

LATEST=$(git tag --list --sort=-v:refname 'V*' 2>/dev/null | head -1)

case "$ARG_BUMP" in
    major|minor|patch|beta|final)
        if [[ -z $LATEST ]]; then
            echo "error: no V* tag to bump from yet - give the first version: ./do-release 0.1.0-beta.1" >&2
            exit 1
        fi

        if [[ ! $LATEST =~ '^[Vv]([0-9]+)\.([0-9]+)\.([0-9]+)(-beta\.([0-9]+))?$' ]]; then
            echo "error: newest tag '$LATEST' is not V<n>.<n>.<n>[-beta.<n>]; give a version instead." >&2
            exit 1
        fi
        MAJOR=$match[1]
        MINOR=$match[2]
        PATCH=$match[3]
        BETA=$match[5]

        case "$ARG_BUMP" in
            major) (( MAJOR++ )); MINOR=0; PATCH=0; BETA=1 ;;
            minor) (( MINOR++ ));          PATCH=0; BETA=1 ;;
            patch) (( PATCH++ ));                   BETA=1 ;;
            beta)
                if [[ -z $BETA ]]; then
                    echo "error: '$LATEST' has no -beta.n to bump; use 'patch' to start a new beta series." >&2
                    exit 1
                fi
                (( BETA++ ))
                ;;
            final) BETA="" ;;
        esac
        VERSION="V$MAJOR.$MINOR.$PATCH${BETA:+-beta.$BETA}"

        if git rev-parse -q --verify "refs/tags/$VERSION" >/dev/null; then
            echo "error: tag $VERSION already exists." >&2
            exit 1
        fi
        NEW_TAG="$VERSION"
        echo "==> version $VERSION ($ARG_BUMP bump from $LATEST)"
        ;;

    "")
        if [[ -z $LATEST ]]; then
            echo "error: no tag yet and no version given - try: ./do-release 0.1.0-beta.1" >&2
            exit 1
        fi
        VERSION="$LATEST"
        NEW_TAG=""
        echo "==> version $VERSION (reusing newest tag)"

        if [[ -n $(git rev-list "$LATEST"..HEAD 2>/dev/null) ]]; then
            echo "    WARNING: HEAD is ahead of $LATEST - this .dmg holds code that is not in that tag." >&2
        fi
        ;;

    *)
        if [[ ! $ARG_BUMP =~ '^[Vv]?[0-9]+\.' ]]; then
            echo "error: '$ARG_BUMP' is not a bump keyword (major minor patch beta final) or a version." >&2
            exit 1
        fi
        VERSION="V${ARG_BUMP#[Vv]}"
        NEW_TAG="$VERSION"
        echo "==> version $VERSION (specified)"
        ;;
esac

if [[ -n $(git status --porcelain 2>/dev/null) ]]; then
    echo "    WARNING: working tree has uncommitted changes" >&2
fi
VERSION_CLEAN="${VERSION#[Vv]}"

# --- the plug-ins --------------------------------------------------------

echo "==> building the plug-ins"

# --no-install: a release must not disturb what is installed for testing
if ! P2A_VERSION="$VERSION_CLEAN" P2A_PLUGIN_OUT_DIR="$WORK/plugins" ./do-plugin --no-install >"$WORK/build.log" 2>&1; then
    tail -20 "$WORK/build.log" >&2
    echo "error: the plug-in build failed (log above)." >&2
    exit 1
fi

VST3="$WORK/plugins/Pulse2Alike.vst3"
AU="$WORK/plugins/Pulse2Alike.component"

for b in "$VST3" "$AU"; do
    if [[ ! -d $b ]]; then
        echo "error: $b was not built - a release ships both formats (is the VST3 SDK there? see do-plugin)." >&2
        exit 1
    fi
    codesign --verify --strict "$b"
done
ARCHS=$(lipo -archs "$VST3/Contents/MacOS/Pulse2Alike" 2>/dev/null || echo "?")
echo "==> built both formats ($ARCHS), version $VERSION_CLEAN"

# --- the .dmg ------------------------------------------------------------

STAGE="$WORK/stage"
mkdir -p "$STAGE"
cp -R "$VST3" "$AU" "$STAGE/"
cp LICENSE "$STAGE/LICENSE.txt"

# THIRD_PARTY.md: FreeType (statically linked, FTL - the credit below is mandatory) and the VST3 SDK (MIT - its
# notice travels with the binary). A release without them stops.
FTL="SynthLib/ThirdParty/freetype/docs/FTL.TXT"
VST3_LICENSE="${VST3_SDK:-$HOME/Documents/vst3sdk}/LICENSE.txt"

for f in "$FTL" "$VST3_LICENSE"; do
    if [[ ! -f $f ]]; then
        echo "error: $f is missing - a release must carry it (THIRD_PARTY.md)." >&2
        exit 1
    fi
done
mkdir -p "$STAGE/Licences"
cp "$FTL" "$STAGE/Licences/FreeType FTL.txt"
cp "$VST3_LICENSE" "$STAGE/Licences/VST3 SDK LICENSE.txt"

cat > "$STAGE/Read Me First.txt" <<EOF
Pulse2Alike $VERSION_CLEAN
A reproduction inspired by the Waldorf Pulse 2, as a VST3 and an Audio Unit plug-in for macOS 12 or later
(Apple silicon and Intel).

INSTALLING

Copy the plug-ins into the system plug-in folders:

    Pulse2Alike.vst3       ->  /Library/Audio/Plug-Ins/VST3
    Pulse2Alike.component  ->  /Library/Audio/Plug-Ins/Components

In Finder: Go > Go to Folder..., type the folder's path, and drag the plug-in in.

These builds are not notarized (there is no paid Apple developer membership behind them), so macOS
quarantines them and a host will refuse to load them until the quarantine is cleared. In Terminal:

    sudo xattr -dr com.apple.quarantine /Library/Audio/Plug-Ins/VST3/Pulse2Alike.vst3
    sudo xattr -dr com.apple.quarantine /Library/Audio/Plug-Ins/Components/Pulse2Alike.component

Then restart the host (or rescan its plug-ins). For the Audio Unit, a log-out and in may be needed
before the host sees it.

SOUNDS

The plug-in keeps 500 presets, P001-P500, as the instrument does; program changes (bank select CC 32,
then program change) play them. They start as INIT. To fill them: Presets > Import Presets from Folder
(a folder of "NNN Name.syx" sound dumps) or from File (a .syx of dumps), or, with a Pulse 2 on USB,
Pulse 2 > Backup Pulse 2 to Presets. Single sounds are .syx files, through the File menu. The plug-in's
Help menu says more.

LICENCE

GPL version 3 - see LICENSE.txt.

Portions of this software are copyright (C) The FreeType Project (www.freetype.org). All rights reserved.
This software is based in part on the work of the FreeType Team. Its licence, and the VST3 SDK's, are in
the Licences folder.
EOF

DMG="$DIST/Pulse2Alike-$VERSION_CLEAN.dmg"
rm -f "$DMG"
# macOS 27 deprecates `hdiutil create` for `diskutil image create from` (APFS, readable from macOS 10.13); older
# systems keep hdiutil, as G2-Edit's do-release does
if diskutil image create from -h >/dev/null 2>&1; then
    diskutil image create from --format UDZO --volumeName "$VOL_NAME $VERSION_CLEAN" "$STAGE" "$DMG" >/dev/null
else
    hdiutil create -volname "$VOL_NAME $VERSION_CLEAN" -srcfolder "$STAGE" -fs HFS+ -format UDZO -ov "$DMG" >/dev/null
fi
echo "==> $DMG"
echo "    contains: Pulse2Alike.vst3, Pulse2Alike.component, Read Me First.txt, LICENSE.txt, Licences/"

if [[ -n $NEW_TAG ]]; then
    echo
    echo "Once the .dmg has been checked:"
    echo "    git tag $NEW_TAG && git push origin $NEW_TAG"
fi
